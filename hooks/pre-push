#!/usr/bin/env python3
"""pre-push: run the authoritative test suite — the EXACT gate CI runs — before any push.

The division of labour: `pre-commit` does the fast, PARTIAL sync (validate + build + stage the
regenerated HTML). This hook runs the FULL `catalog_tests.py --full` — the same command the CI /
deploy gate runs — so a change that would fail CI cannot leave the machine. That closes the gap
this hook was born from: a local `validate` + `build` (+ a PDF render) all passed, yet CI's
tracked-HTML orphan check failed, because the test suite ran only in CI.

Install once with `python3 catalog.py install-hooks` (sets core.hooksPath=hooks). No shell — pure
Python, per the repo's tooling posture.

Bypass (humans, rare — e.g. pushing a WIP branch): `git push --no-verify`.
"""
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

print("pre-push: running catalog_tests.py --full (the CI gate) …", file=sys.stderr)
r = subprocess.run([sys.executable, "catalog_tests.py", "--full"], cwd=ROOT)
if r.returncode:
    sys.stderr.write(
        "\npre-push: catalog_tests.py --full FAILED — push refused.\n"
        "Fix the failing gate(s) above, or `git push --no-verify` to override (rare).\n")
    sys.exit(r.returncode)
