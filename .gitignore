__pycache__/
*.pyc
.DS_Store
/site/
/_site/
.claude/
plugin/**/*.html
node_modules/

# local-only marketplace-submission blurb (not published, not committed)
/SUBMISSION.md

# internal continuity/handoff docs — kept locally, never shipped to the public repo
/HANDOFF*.md

# local-only book-proposal drafts (not published, not committed)
/BOOK-PROPOSAL*.md

# local scratch (never rendered/served — see catalog.py catalogue_md_files)
*.local.html

# held mechanism drafts (design-stage, not yet promoted) + local-scratch markdown —
# kept locally, never shipped; the guard against a broad `git add -A` sweeping them in
/_drafts/
/book/_drafts/
*.local.md

# local-only publisher pitches (not published, not committed)
/book/_pitch/

# combined print-HTML intermediate for the PDF build (regenerated by `build_book_html.py --pdf`)
/book/_print/

# build-time mermaid→SVG render cache (content-hashed; regenerated by build_book_html.py via mmdc)
/book/.mermaid-svg-cache/

# The rendered book PDF is a CI-GENERATED, Pages-PUBLISHED artifact — NOT committed to git (avoids a
# multi-MB binary in history). `build_book_html.py --pdf` regenerates it locally (gitignored preview);
# the Pages workflow regenerates + publishes it at /book/mage-book.pdf on the deployed site.
/book/mage-book.pdf

# Node build tooling for the PDF render (Puppeteer). package.json + package-lock.json ARE tracked (CI
# runs `npm ci`); the installed tree is not.
/book/node_modules/
